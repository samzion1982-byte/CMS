# Copy to .env.local for local dev, or set these in each Vercel project.
# Never put the Supabase service-role key in Vite/Vercel frontend env vars.
# Auth Admin (Users page) uses Edge Function `cms-admin` with the server-side secret.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
